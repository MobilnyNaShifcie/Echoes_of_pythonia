# Copy to .env. NEVER commit the real .env or share its contents.
OPENAI_API_KEY=

EOP_DEVELOPER_MODEL=gpt-6-astra
EOP_REVIEWER_MODEL=gpt-5.6-sol
EOP_DEVELOPER_REASONING=medium
EOP_REVIEWER_REASONING=medium
EOP_MAX_REVIEW_ROUNDS=4

EOP_CONTEXT_MAX_CHARS=22000
EOP_CONTEXT_MAX_SECTIONS=18
EOP_REPO_BRIEF_MAX_CHARS=26000
EOP_REPO_BRIEF_MAX_FILES=8
EOP_REPO_BRIEF_SNIPPETS_PER_FILE=2

# Hard cost fuse. 2 = one Astra + one Sol call. 4 = max one correction round.
EOP_MAX_MODEL_CALLS_PER_TASK=4
