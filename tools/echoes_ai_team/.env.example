# Copy this file to .env and paste your OpenAI API key there.
# NEVER commit .env and never send screenshots containing the key.
OPENAI_API_KEY=

# Official model IDs.
EOP_DEVELOPER_MODEL=gpt-6-astra
EOP_REVIEWER_MODEL=gpt-5.6-sol

# Reasoning effort: low / medium / high
EOP_DEVELOPER_REASONING=high
EOP_REVIEWER_REASONING=high

# Planning review loop limit.
EOP_MAX_REVIEW_ROUNDS=4
