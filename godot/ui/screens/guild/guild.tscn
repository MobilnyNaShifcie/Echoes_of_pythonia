[sub_resource type="StyleBoxEmpty" id="HitStyle"]

[sub_resource type="Shader" id="GuildmasterHighlightShader"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec2 highlight_center = vec2(0.285, 0.635);\nuniform vec2 highlight_radius = vec2(0.135, 0.38);\nuniform float highlight_strength = 0.4;\n\nvoid fragment() {\n\tvec4 sampled = texture(TEXTURE, UV);\n\tvec2 ellipse = (UV - highlight_center) / highlight_radius;\n\tfloat mask = 1.0 - smoothstep(0.62, 1.0, length(ellipse));\n\tCOLOR = vec4(sampled.rgb * mask * highlight_strength, sampled.a * mask * highlight_strength);\n}\n"

[sub_resource type="ShaderMaterial" id="GuildmasterHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("GuildmasterHighlightShader")

