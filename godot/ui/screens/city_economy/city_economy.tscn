[sub_resource type="Shader" id="Shader_informant_glow"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec2 glow_center = vec2(0.588, 0.515);\nuniform vec2 glow_radius = vec2(0.072, 0.17);\nuniform float glow_strength : hint_range(0.0, 1.0) = 1.0;\n\nvoid fragment() {\n\tvec4 sampled = texture(TEXTURE, UV);\n\tvec2 ellipse = (UV - glow_center) / glow_radius;\n\tfloat mask = 1.0 - smoothstep(0.35, 1.0, length(ellipse));\n\tfloat alpha = sampled.a * mask * glow_strength * 0.18;\n\tCOLOR = vec4(sampled.rgb * mask * glow_strength * 0.24, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_informant_glow"]
resource_local_to_scene = true
shader = SubResource("Shader_informant_glow")

[sub_resource type="Shader" id="Shader_counter_foreground"]
code = "shader_type canvas_item;\n\nuniform float counter_y : hint_range(0.0, 1.0) = 0.68;\nuniform float counter_slope : hint_range(-0.4, 0.4) = 0.0;\nuniform float counter_left : hint_range(0.0, 1.0) = 0.0;\nuniform float counter_right : hint_range(0.0, 1.0) = 1.0;\nuniform float background_shade : hint_range(0.0, 1.0) = 0.8;\n\nvoid fragment() {\n\tvec4 sampled = texture(TEXTURE, UV);\n\tfloat cutoff = counter_y + counter_slope * (UV.x - 0.5);\n\tfloat counter_mask = step(cutoff, UV.y) * step(counter_left, UV.x) * step(UV.x, counter_right);\n\tCOLOR = vec4(sampled.rgb * background_shade, sampled.a * counter_mask);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_counter_foreground"]
resource_local_to_scene = true
shader = SubResource("Shader_counter_foreground")

[sub_resource type="Shader" id="Shader_integrated_npc_highlight"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec2 highlight_center = vec2(0.5, 0.5);\nuniform vec2 highlight_radius = vec2(0.15, 0.35);\nuniform float highlight_strength : hint_range(0.0, 0.5) = 0.28;\n\nvoid fragment() {\n\tvec4 sampled = texture(TEXTURE, UV);\n\tvec2 ellipse = (UV - highlight_center) / highlight_radius;\n\tfloat mask = 1.0 - smoothstep(0.62, 1.0, length(ellipse));\n\tCOLOR = vec4(sampled.rgb * mask * highlight_strength, sampled.a * mask * highlight_strength);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_integrated_npc_highlight"]
resource_local_to_scene = true
shader = SubResource("Shader_integrated_npc_highlight")

