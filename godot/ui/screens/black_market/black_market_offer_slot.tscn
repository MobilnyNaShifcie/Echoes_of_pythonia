[sub_resource type="Shader" id="ShaderDisplayGrade"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nuniform float saturation = 0.72;\nuniform vec3 ambient_tint = vec3(0.86, 0.76, 0.64);\n\nvoid fragment() {\n\tvec4 vertex_tint = COLOR;\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat gray = dot(source.rgb, vec3(0.299, 0.587, 0.114));\n\tfloat side_light = mix(1.05, 0.88, UV.x);\n\tfloat base_shadow = mix(1.0, 0.68, smoothstep(0.62, 1.0, UV.y));\n\tvec3 graded = mix(vec3(gray), source.rgb, saturation);\n\tgraded *= ambient_tint * side_light * base_shadow;\n\tCOLOR = vec4(graded, source.a) * vertex_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialDisplayGrade"]
shader = SubResource("ShaderDisplayGrade")

